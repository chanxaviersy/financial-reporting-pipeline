# ==========================================
# 财务月报管道 - 环境变量示例
# ==========================================
# 复制此文件为 .env 并填入你的实际配置：
#   cp .env.example .env
# ⚠️ .env 已加入 .gitignore，不会被提交

# ---------- 数据库 ----------
# 财务数据库连接（生产环境）
DATABASE_URL=postgresql://user:password@localhost:5432/finance
# SQLite 测试库（开发环境）
TEST_DATABASE_URL=sqlite:///test_finance.db

# ---------- 报告 ----------
# 报告输出目录
REPORT_OUTPUT_DIR=reports/
# Excel 模板路径
EXCEL_TEMPLATE_PATH=configs/report_template.xlsx

# ---------- 告警 ----------
# 风险阈值（差异率超过此值触发告警）
RISK_THRESHOLD=0.05
# 告警邮箱
ALERT_EMAIL=finance-alerts@company.com
